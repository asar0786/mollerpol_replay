th1d hmollerPol_polgem_m0_StripTime_good_CM 'mollerPol.polgem.m0; Strip Mean Time (ns);' mollerPol.polgem.m0.strip.Tmean[I] 150 0 150 mollerPol.polgem.m0.strip.CM_GOOD[I]
th1d hmollerPol_polgem_m0_StripTsigma_good_CM 'mollerPol.polgem.m0; Strip RMS Time (ns);' mollerPol.polgem.m0.strip.Tsigma[I] 150 0 150 mollerPol.polgem.m0.strip.CM_GOOD[I]

