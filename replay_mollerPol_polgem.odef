th1d hmollerPol_polgem_m0_ADCmax_good_CM 'mollerPol.polgem.m0; Strip ADC max; ' mollerPol.polgem.m0.strip.ADCmax[I] 500 0 4000 mollerPol.polgem.m0.strip.CM_GOOD[I]
th1d hmollerPol_polgem_m0_ADCsum_good_CM 'mollerPol.polgem.m0; Strip ADC sum; ' mollerPol.polgem.m0.strip.ADCsum[I] 1000 0 15000 mollerPol.polgem.m0.strip.CM_GOOD[I]
