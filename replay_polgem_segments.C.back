void replay_polgem_segments(
    int runnum = 1857,
    const char* datadir = "/volatile/halla/moller12gev/asar/TestLab_Data",
    int firstseg = 0,
    int lastseg  = 1,      // -1 = auto until missing file
    long firstevent = 0,
    long nevents    = 5000,    // 0 = all events in each segment
    const char* out = "Rootfiles/polgem_allseg_new.root"
){
  gSystem->Setenv("DB_DIR", "DB/20230226");
  // Apparatus + detector (NOTE: class names are still the original ones)
  auto* mollerPol = new MOLLERSpectrometer("mollerPol", "Generic apparatus");
  auto* polgem    = new MOLLERGEMSpectrometerTracker("polgem", "cosmic stand");
  mollerPol->AddDetector(polgem);
  gHaApps->Add(mollerPol);

  // Analyzer
  auto* analyzer = new THaAnalyzer;
  analyzer->SetVerbosity(2);
  analyzer->SetMarkInterval(100);
  analyzer->SetOutFile(out);
  analyzer->SetOdefFile("replay_mollerPol_polgem.odef");
  analyzer->SetSummaryFile(Form("log/summary_polgem_%d.log", runnum));

  auto* event = new THaEvent;
  analyzer->SetEvent(event);

  TDatime now;

  int seg = firstseg;
  int nseg_used = 0;

  while(true){
    if(lastseg >= 0 && seg > lastseg) break;

    TString f;
    f.Form("%s/moller_ssp_%d.evio.%d", datadir, runnum, seg);

    if( gSystem->AccessPathName(f.Data()) ){
      // if user asked auto, stop at first missing segment
      if(lastseg < 0) break;

      // if user gave explicit lastseg, just skip missing ones
      seg++;
      continue;
    }

    cout << ">>> Processing segment " << seg << " : " << f << endl;

    THaRun run(f.Data());
    run.SetNumber(runnum);
    run.SetDate(now);
    run.SetFirstEvent(firstevent);

    if(nevents > 0)
      run.SetLastEvent(firstevent + nevents - 1);

    // cosmic / SSP
    run.SetDataRequired(0);

    analyzer->Process(run);

    nseg_used++;
    seg++;
  }

  cout << ">>> Done. Segments processed = " << nseg_used << endl;
}

